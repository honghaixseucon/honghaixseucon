require('dotenv').config();
const express = require('express');
const cors = require('cors');

const app = express();
const PORT = process.env.PORT || 5000;

// Middleware bảo mật và phân tích dữ liệu
app.use(cors());
app.use(express.json());

// API Kiểm tra trạng thái máy chủ
app.get('/api/health', (req, res) => {
    res.status(200).json({
        status: 'success',
        system: 'Hồng Hải Media Full System 2026',
        timestamp: new Date().toISOString()
    });
});

// Định tuyến API cơ bản
app.post('/api/auth/login', (req, res) => {
    const { email, password } = req.body;
    // Logic xác thực thực tế kết nối cơ sở dữ liệu PostgreSQL
    if(email && password) {
        res.json({ success: true, message: 'Đăng nhập thành công hệ thống Hồng Hải Media', token: 'mock_jwt_token_2026' });
    } else {
        res.status(400).json({ success: false, message: 'Vui lòng cung cấp đầy đủ thông tin đăng nhập!' });
    }
});

// Khởi chạy máy chủ
app.listen(PORT, () => {
    console.log(`[HỒNG HẢI BACKEND] Đang chạy thành công trên cổng: ${PORT}`);
});
